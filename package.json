{
  "name": "omo-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "pocketbase:install": "node --import tsx scripts/install-pocketbase.ts",
    "pocketbase:bundle": "node --import tsx scripts/bundle-pocketbase.ts",
    "dev:bot": "node --env-file=.env --import tsx apps/bot/src/main.ts",
    "dev:web": "node --env-file=.env --import tsx apps/web/src/main.ts",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "db:migrate": "node --env-file=.env --import tsx packages/db/src/migrate-cli.ts",
    "discord:commands:sync": "node --env-file=.env --import tsx scripts/sync-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && pnpm build:demo && playwright test",
    "build": "node --import tsx scripts/build.ts && vite build --config apps/dashboard/vite.config.ts",
    "build:demo": "node --import tsx scripts/build.ts && vite build --config apps/dashboard/vite.config.ts --mode fixture",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm build",
    "start:web": "node dist/web/main.js",
    "start:bot": "node dist/bot/main.js",
    "start": "node dist/setup/main.js",
    "dev:setup": "node --import tsx apps/setup/src/main.ts",
    "module:create": "node --import tsx scripts/module-tools.ts create",
    "module:sync": "node --import tsx scripts/module-tools.ts sync",
    "module:add": "node --import tsx scripts/module-tools.ts add",
    "module:remove": "node --import tsx scripts/module-tools.ts remove",
    "licenses:generate": "node --import tsx scripts/license-notices.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "discord.js": "14.27.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "lucide-react": "1.48.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "ssh2": "1.17.0",
    "ssh2-sftp-client": "12.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.5",
    "@types/ssh2-sftp-client": "9.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "license": "Apache-2.0"
}
