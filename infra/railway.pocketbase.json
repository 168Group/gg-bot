{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/Dockerfile.pocketbase",
    "watchPatterns": ["infra/pocketbase/**", "infra/Dockerfile.pocketbase", "infra/railway.pocketbase.json"]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 30,
    "restartPolicyType": "ALWAYS"
  }
}
