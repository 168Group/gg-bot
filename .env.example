NODE_ENV=development
STORAGE_PROVIDER=pocketbase
# PocketHost instance origin. Use its permanent UUID hostname if desired.
POCKETBASE_URL=https://YOUR_INSTANCE.pockethost.io
# Generate a random 32-byte hex value; also store it as OMO_STORAGE_KEY in PocketHost Secrets.
POCKETBASE_SERVICE_KEY=GENERATE_64_HEX_CHARACTERS
# Only needed with STORAGE_PROVIDER=postgres:
DATABASE_URL=postgresql://omo:local_only@localhost:5432/omo
MIGRATION_DATABASE_URL=postgresql://omo:local_only@localhost:5432/omo
DISCORD_GUILD_ID=REPLACE_ME
DISCORD_APPLICATION_ID=REPLACE_ME
DISCORD_BOT_TOKEN=REPLACE_ME
DISCORD_CLIENT_SECRET=REPLACE_ME
DASHBOARD_ORIGIN=http://localhost:3000
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SESSION_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
OWNER_USER_IDS=REPLACE_ME
DASHBOARD_ADMIN_ROLE_IDS=
DASHBOARD_VIEWER_ROLE_IDS=
BOT_NAME=OMO Bot
COMMUNITY_NAME=My Community
WEB_PORT=3000
BOT_HEALTH_PORT=3001
LOG_LEVEL=info
